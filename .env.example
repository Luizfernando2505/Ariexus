# Copie para .env.local. Nunca faça commit de .env*.

# Supabase: Project Settings > API. As duas são públicas; os dados são protegidos pelo RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # ou NEXT_PUBLIC_SUPABASE_ANON_KEY em projetos antigos

# Opcional: endereço público usado no link mágico (na Vercel é detectado sozinho).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fase 2: análise da oferta. Tudo só no servidor; nunca use o prefixo NEXT_PUBLIC_ aqui.
# Modo da análise: sem nada, é "simulado" fora da produção e "desligado" em produção.
# A IA de verdade só liga com ANALISE_PROVEDOR=anthropic E a chave definida (gera custo).
# ANALISE_PROVEDOR=desligado | simulado | anthropic
# ANTHROPIC_API_KEY=
# ANALISE_MODELO=claude-opus-5-5   # opcional: claude-sonnet-5-5 ou claude-haiku-5-5

# Só para teste local de ponta a ponta: deixa ler páginas em 127.0.0.1. Ignorado na Vercel.
# ARIEXUS_TESTE_REDE_LOCAL=1
